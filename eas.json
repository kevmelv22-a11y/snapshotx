{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "image": "latest"
      }
    },
    "ios-adhoc": {
      "distribution": "internal",
      "channel": "ios-adhoc",
      "env": {
        "SNAPSHOTX_IOS_ADHOC_BUNDLE_ID": "app.star4684.aquila7560"
      },
      "ios": {
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true,
        "image": "latest"
      }
    }
  }
}
