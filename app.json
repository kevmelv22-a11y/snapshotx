{
  "expo": {
    "name": "SnapShot X",
    "slug": "snapshot-x",
    "owner": "kevke-026s-team",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8e081584-5001-428c-bcac-302a88101f8f",
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "portrait",
    "icon": "./assets/snapshotx-app-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snapshotx.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SnapShot X gebruikt je camera voor foto’s, video’s en videogesprekken.",
        "NSMicrophoneUsageDescription": "SnapShot X gebruikt je microfoon voor video, spraakberichten en (video)gesprekken.",
        "NSPhotoLibraryAddUsageDescription": "Bewaar snaps in je fotobibliotheek.",
        "NSPhotoLibraryUsageDescription": "SnapShot X opent je fotobibliotheek zodat je foto’s en video’s kunt versturen of een foto als chat-achtergrond kunt kiezen.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#040404",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.snapshotx.app"
    },
    "web": {
      "favicon": "./assets/snapshotx-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#08090E",
            "image": "./assets/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SnapShot X gebruikt je camera om snaps te maken en voor videogesprekken.",
          "microphonePermission": "SnapShot X gebruikt je microfoon voor video, spraak en (video)gesprekken."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "SnapShot X bewaart snaps in je fotobibliotheek."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SnapShot X gebruikt je locatie alleen wanneer je ervoor kiest die op de vriendenkaart te delen."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-video",
      "expo-audio",
      "expo-font",
      "expo-asset",
      "./plugins/withIosSceneLifecycle",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Bliksem",
            "ios": "./assets/app-icons/bliksem.png",
            "android": {
              "foregroundImage": "./assets/app-icons/bliksem.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "VuurIjs",
            "ios": "./assets/app-icons/vuurijs.png",
            "android": {
              "foregroundImage": "./assets/app-icons/vuurijs.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Ringen",
            "ios": "./assets/app-icons/ringen.png",
            "android": {
              "foregroundImage": "./assets/app-icons/ringen.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Lens",
            "ios": "./assets/app-icons/lens.png",
            "android": {
              "foregroundImage": "./assets/app-icons/lens.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Schild",
            "ios": "./assets/app-icons/schild.png",
            "android": {
              "foregroundImage": "./assets/app-icons/schild.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "NeonSpook",
            "ios": "./assets/app-icons/neonspook.png",
            "android": {
              "foregroundImage": "./assets/app-icons/neonspook.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Glas",
            "ios": "./assets/app-icons/glas.png",
            "android": {
              "foregroundImage": "./assets/app-icons/glas.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Gloed",
            "ios": "./assets/app-icons/gloed.png",
            "android": {
              "foregroundImage": "./assets/app-icons/gloed.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "SnapX",
            "ios": "./assets/app-icons/snapx.png",
            "android": {
              "foregroundImage": "./assets/app-icons/snapx.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Boog",
            "ios": "./assets/app-icons/boog.png",
            "android": {
              "foregroundImage": "./assets/app-icons/boog.png",
              "backgroundColor": "#000000"
            }
          }
        ]
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "SnapShot X gebruikt je camera voor videogesprekken met je vrienden.",
          "microphonePermission": "SnapShot X gebruikt je microfoon voor (video)gesprekken met je vrienden."
        }
      ]
    ],
    "scheme": "snapshotx",
    "backgroundColor": "#08090E",
    "extra": {
      "eas": {
        "projectId": "8e081584-5001-428c-bcac-302a88101f8f"
      }
    }
  }
}
