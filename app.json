{
  "expo": {
    "name": "SnapShot X",
    "slug": "snapshot-x",
    "owner": "kevke-026s-team",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8e081584-5001-428c-bcac-302a88101f8f",
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "portrait",
    "icon": "./assets/snapshotx-app-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snapshotx.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Maak foto’s en video’s voor SnapShot X.",
        "NSMicrophoneUsageDescription": "Neem video en spraakberichten op.",
        "NSPhotoLibraryAddUsageDescription": "Bewaar snaps in je fotobibliotheek.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#040404",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.snapshotx.app"
    },
    "web": {
      "favicon": "./assets/snapshotx-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SnapShot X gebruikt je camera om snaps te maken.",
          "microphonePermission": "SnapShot X gebruikt je microfoon voor video en spraak."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "SnapShot X bewaart snaps in je fotobibliotheek."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SnapShot X gebruikt je locatie alleen wanneer je ervoor kiest die op de vriendenkaart te delen."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-video",
      "expo-audio",
      "expo-font",
      "expo-asset",
      "./plugins/withIosSceneLifecycle"
    ],
    "scheme": "snapshotx",
    "backgroundColor": "#08090E",
    "extra": {
      "eas": {
        "projectId": "8e081584-5001-428c-bcac-302a88101f8f"
      }
    }
  }
}
